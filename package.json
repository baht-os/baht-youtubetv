{
    "name": "baht-youtubetv",
    "productName": "BAHT YouTube TV",
    "version": "3.0.1-baht.1",
    "description": "YouTube TV (leanback) for BAHT TV OS – fork of marcosrg9/YouTubeTV.",
    "main": "main.js",
    "scripts": {
        "start": "tsc && electron main.js",
        "debug": "electron . --inspect",
        "compile": "tsc && cd renderers/settings/static && tsc",
        "build": "npm run build:mac && npm run build:winARM && build:winx64 && npm run build:linux",
        "build:mac": "electron-builder --mac --x64 --arm64",
        "build:winARM": "electron-builder --win --arm64",
        "build:winx64": "electron-builder --win --x64",
        "build:linux": "electron-builder --linux dir --x64",
        "buildRetinaDMGBackground": "tiffutil -cathidpicheck background.png background@2x.png -out background.tiff",
        "build:baht": "npm run compile && electron-builder --linux dir --x64 --publish never",
        "test": "tsc && node --test test/allowed.test.js"
    },
    "dependencies": {
        "auto-launch": "^5.0.6"
    },
    "devDependencies": {
        "@ghostery/adblocker-electron": "^2.13.0",
        "@types/auto-launch": "^5.0.5",
        "@types/node": "^22.20.5",
        "electron": "44.8.0",
        "electron-builder": "^26.15.3",
        "typescript": "~5.9.3"
    },
    "build": {
        "productName": "BAHT YouTube TV",
        "appId": "org.baht.youtubetv",
        "asar": true,
        "directories": {
            "output": "dist"
        },
        "extraResources": [
            {
                "from": "./data/persistence.placeholder.json",
                "to": "./data/persistence.placeholder.json",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./i18n/",
                "to": "./i18n/",
                "filter": [
                    "**/*.json"
                ]
            }
        ],
        "mac": {
            "category": "public.app-category.entertainment",
            "target": "dmg",
            "icon": "build/youtube_bigsur_icon.icns"
        },
        "dmg": {
            "contents": [
                {
                    "x": 207,
                    "y": 253
                },
                {
                    "x": 494,
                    "y": 253,
                    "type": "link",
                    "path": "/Applications"
                }
            ],
            "background": "build/background.tiff"
        },
        "linux": {
            "target": [
                "dir"
            ],
            "executableName": "baht-youtubetv",
            "icon": "build/icon.icns",
            "category": "AudioVideo"
        },
        "win": {
            "target": "NSIS",
            "icon": "build/icon.ico"
        }
    },
    "author": "Marcos Rodríguez <marcosylrg@gmail.com>",
    "contributors": [
        "BAHT project <https://github.com/baht-os>"
    ]
}
